ANTHROPIC_API_KEY=
PORT=3000

# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign teacher/admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only used by `npm run seed-admin` if you don't pass username/password as args.
ADMIN_USERNAME=
ADMIN_PASSWORD=
